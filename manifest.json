{
  "manifest_version": 3,
  "name": "Monet's Water Lilies",
  "short_name": "Water Lilies",
  "version": "1.0.0",
  "description": "A calm Google Chrome theme inspired by Claude Monet's Water Lilies.",
  "theme": {
    "images": {
      "theme_ntp_background": "images/theme_ntp_background.png"
    },
    "colors": {
      "frame": [25, 54, 91],
      "frame_inactive": [25, 54, 91],
      "frame_incognito": [25, 54, 91],
      "frame_incognito_inactive": [25, 54, 91],
      "toolbar": [25, 54, 91],
      "tab_text": [255, 255, 255],
      "tab_background_text": [220, 230, 242],
      "bookmark_text": [255, 255, 255],
      "ntp_background": [25, 54, 91],
      "ntp_text": [255, 255, 255],
      "ntp_link": [190, 210, 235],
      "button_background": [25, 54, 91],
      "omnibox_background": [25, 54, 91],
      "omnibox_text": [255, 255, 255]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    }
  }
}